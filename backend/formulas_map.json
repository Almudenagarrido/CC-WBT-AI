{
  "{country}\\carbon-credits-general.xlsx": {
    "Carbon Credits": [
        {
            "formula_steps": [
            { "op": "copy", "operands": [["index", 0]], "result": "final" }
            ],
            "target": "CO2 emited - {model} scenario",
            "sources": [
                "{country}\\upload-{model}.xlsx::Carbon Credits::CO2 emited - {model} scenario"
            ]
        },
        {
            "formula_steps": [
            { "op": "subtract", "operands": [["index", 0], ["index", 1]], "result": "final" }
            ],
            "target": "{model} vs. BAU",
            "sources": [
                "{country}\\carbon-credits-general.xlsx::Carbon Credits::CO2 emited - BAU scenario",
                "{country}\\carbon-credits-general.xlsx::Carbon Credits::CO2 emited - {model} scenario"
            ]
        },
        {
            "formula_steps": [
            { "op": "multiply", "operands": [["index", 0], ["index", 1]], "result": "temp1" },
            { "op": "multiply", "operands": [["index", 2], ["index", "temp1"]], "result": "final" }
            ],
            "target": "Potential income from Carbon Credits in the {model} Plan - right",
            "sources": [
                "{country}\\carbon-credits-general.xlsx::Carbon Credits::CO2 equivalent avoided in the {model}",
                "{country}\\fuel-financial-inputs.xlsx::Carbon Credits::Liquidity",
                "{country}\\fuel-financial-inputs.xlsx::Carbon Credits::Price per TON"
            ]
        }
    ]
  },
