{
  "{country}\\carbon-credits-general.xlsx": {
    "Carbon Credits": [
        {
            "formula_steps": [
            { "op": "copy", "operands": [["index", 0]], "result": "final" }
            ],
            "target": "CO2 emited - {model} scenario",
            "sources": [
                "{country}\\upload-{model}.xlsx::Carbon Credits::CO2 emited - {model} scenario"
            ]
        },
        {
            "formula_steps": [
            { "op": "subtraction", "operands": [["index", 0], ["index", 1]], "result": "final" }
            ],
            "target": "{model} vs. BAU",
            "sources": [
                "{country}\\carbon-credits-general.xlsx::Carbon Credits::CO2 emited - BAU scenario",
                "{country}\\carbon-credits-general.xlsx::Carbon Credits::CO2 emited - {model} scenario"
            ]
        },
        {
            "formula_steps": [
                {"op": "range", "operands": [["literal", 1]], "result": "temp1"},
                {"op": "value", "operands": [["index", 0], ["literal", 0]], "result": "temp2"},
                {"op": "gt", "operands": [["index", "temp1"], ["index", "temp2"]], "result": "temp3"},
                {"op": "sum_range", "operands": [["index", 1], ["index", "temp2"]], "direction": "backward", "result": "temp4"},
                {"op": "if", "operands": [["index", "temp3"], ["index", "temp4"], ["index", 1]], "result": "temp5"}, 
                {"op": "multiply_per", "operands": [["index", "temp5"], ["index", 2]], "result": "temp6"},
                {"op": "max", "operands": [["index", "temp6"], ["literal", 0]], "result": "final"}
            ],
            "target": "CO2 equivalent avoided in the {model}",
            "sources": [
                "{country}\\fuel-financial-inputs.xlsx::Carbon Credits::Number of years that you could sell those carbon credits", 
                "{country}\\carbon-credits-general.xlsx::Carbon Credits::{model} vs. BAU",
                "{country}\\fuel-financial-inputs.xlsx::Carbon Credits::CO2 certificate (%) - from the total CO2 avoided"
            ]
        },
        {
            "formula_steps": [
            { "op": "multiply_per", "operands": [["index", 0], ["index", 1]], "result": "temp1" },
            { "op": "multiply", "operands": [["index", 2], ["index", "temp1"]], "result": "final" }
            ],
            "target": "Potential income from Carbon Credits in the {model} Plan - right",
            "sources": [
                "{country}\\carbon-credits-general.xlsx::Carbon Credits::CO2 equivalent avoided in the {model}",
                "{country}\\fuel-financial-inputs.xlsx::Carbon Credits::Liquidity",
                "{country}\\fuel-financial-inputs.xlsx::Carbon Credits::Price per TON"
            ]
        }
    ]
  },
